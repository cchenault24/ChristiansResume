# Firebase Configuration
# Get these values from your Firebase project settings (https://console.firebase.google.com/)
# Project Settings > General > Your apps > Firebase SDK snippet > Config

# Firebase API Key - Used to authenticate requests to Firebase services
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain - Domain used for Firebase Authentication
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Project ID - Unique identifier for your Firebase project
VITE_FIREBASE_PROJECT_ID=your_project_id_here

# Firebase Storage Bucket - Cloud Storage bucket for file uploads
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID - Used for Firebase Cloud Messaging (push notifications)
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here

# Firebase App ID - Unique identifier for your Firebase app
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Firebase Measurement ID - Used for Google Analytics integration
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# EmailJS Configuration
# Get these values from your EmailJS dashboard (https://dashboard.emailjs.com/)
# Used for sending contact form submissions via email

# EmailJS Service ID - Identifies your email service provider (e.g., Gmail, Outlook)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here

# EmailJS Template ID - Identifies the email template to use for contact form submissions
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# EmailJS Public Key - Public API key for client-side authentication with EmailJS
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
